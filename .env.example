DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geovit
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Lokal: http://localhost:3000. Produksi: https://nama-proyek.vercel.app
AUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Server-only key; jangan gunakan NEXT_PUBLIC_ untuk private key.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_UPLOAD_FOLDER=/geovit/locations

